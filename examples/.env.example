# AWS Configuration
# The region is fixed: the client uses the global Health endpoint, which follows
# AWS's active/passive failover (see "Regions and availability" in the README).
# AWS_PROFILE=my-profile

# Logging Configuration
LOG_LEVEL=INFO

# API Configuration
HEALTH_API_TIMEOUT=30
HEALTH_API_MAX_CONCURRENCY=5

# Cache Configuration
ENABLE_CACHE=true
CACHE_TTL=300
# The set of services AWS Health covers changes rarely.
SERVICE_LIST_TTL=86400

# AWS Configuration
# The Health API is only reachable through us-east-1, so the region is fixed
# and not configurable.
# AWS_PROFILE=my-profile

# Logging Configuration
LOG_LEVEL=INFO

# API Configuration
HEALTH_API_TIMEOUT=30
HEALTH_API_MAX_CONCURRENCY=5

# Cache Configuration
ENABLE_CACHE=true
CACHE_TTL=300
# The set of services AWS Health covers changes rarely.
SERVICE_LIST_TTL=86400
